generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url = env("DATABASE_URL")
}

model category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  image       String?   @db.VarChar(255)
  description String?
  created_by  String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   users     @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_created_by")
  product     product[]
}

model product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(200)
  price       Int
  slug        String   @unique @db.VarChar(200)
  image       String   @db.VarChar(255)
  description String?
  category_id String   @db.Uuid
  created_by  String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   users    @relation(fields: [created_by], references: [id], onUpdate: NoAction, map: "fk_created_by")
  category    category @relation(fields: [category_id], references: [id], onUpdate: NoAction, map: "fk_category")
}

model role {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role_name        String  @db.VarChar(50)
  slug             String  @unique @db.VarChar(200)
  role_description String?
  users            users[]
}

model users {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name     String     @db.VarChar(100)
  password String     @db.VarChar(255)
  email    String     @unique @db.VarChar(255)
  role_id  String     @db.Uuid
  role     role       @relation(fields: [role_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_role")
  product  product[]
  category category[]
}
