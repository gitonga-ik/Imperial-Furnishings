# PostgreSQL Database Connection String
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/imperial_furnishings"

# Cloudinary Configuration for Image Uploads
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# JWT Secret Key for Session Authentication (generate a secure random 64-char string)
JWT_SECRET_KEY="your_secure_random_jwt_secret_key"
